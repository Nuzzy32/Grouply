                      "expr": {
                        "text": "function K(k){var f=time*24;if(f<=k[0][0])return k[0][1];for(var i=0;i<k.length-1;i++){var a=k[i],c=k[i+1];if(f<=c[0]){var u=(f-a[0])/(c[0]-a[0]);u=u*u*(3-2*u);return a[1]+(c[1]-a[1])*u;}}return k[k.length-1][1];}\nK([[0,0],[6,92],[8,82],[12,95],[16,68],[20,95],[24,68],[28,80],[34,-3],[37,0]])",
