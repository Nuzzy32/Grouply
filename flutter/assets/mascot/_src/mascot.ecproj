                      "expr": {
                        "text": "function K(k){var f=time*24;if(f<=k[0][0])return k[0][1];for(var i=0;i<k.length-1;i++){var a=k[i],c=k[i+1];if(f<=c[0]){var u=(f-a[0])/(c[0]-a[0]);u=u*u*(3-2*u);return [a[1][0]+(c[1][0]-a[1][0])*u, a[1][1]+(c[1][1]-a[1][1])*u];}}return k[k.length-1][1];}\nK([[0,[100,100]],[4,[106,90]],[6,[96,105]],[10,[100,100]],[12,[100,100]],[15,[98,103]],[17,[99,102]],[19,[108,92]],[21,[103,97]],[24,[98.5,101.5]],[28,[100,100]]])",
